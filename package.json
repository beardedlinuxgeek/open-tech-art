{
  "name": "open-tech-art",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "An open catalog of free, openly licensed technical-art resources.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
