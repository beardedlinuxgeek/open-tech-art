---
/**
 * The mark is a sphere that is half wireframe (raw input) and half shaded
 * (the technique applied) — the Raw → Reference idea in one glyph.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id="ota-right"><rect x="16" y="0" width="16" height="32"></rect></clipPath>
    <radialGradient id="ota-shade" cx="0.62" cy="0.34" r="0.75">
      <stop offset="0" stop-color="#ffd2ad"></stop>
      <stop offset="0.45" stop-color="#fb8a3c"></stop>
      <stop offset="1" stop-color="#9a3412"></stop>
    </radialGradient>
  </defs>
  <g fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.9">
    <circle cx="16" cy="16" r="13"></circle>
    <ellipse cx="16" cy="16" rx="6.5" ry="13"></ellipse>
    <path d="M3 16h13M4.8 9.5h11.2M4.8 22.5h11.2"></path>
  </g>
  <circle cx="16" cy="16" r="13" fill="url(#ota-shade)" clip-path="url(#ota-right)"></circle>
  <path d="M16 3v26" stroke="currentColor" stroke-width="1.2"></path>
</svg>
