---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist.</h1>
    <p>The resource may have been renamed or removed. Try the catalog instead.</p>
    <p class="actions">
      <a class="btn btn-primary" href="/resources/">Browse resources</a>
      <a class="btn" href="/">Home</a>
    </p>
  </div>
</Base>

<style>
  .nf {
    padding-block: 96px 32px;
    max-width: 640px;
  }
  .nf h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin: 8px 0 12px;
  }
  .nf p {
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    gap: 10px;
    margin-top: 24px;
  }
</style>
