---
import Base from '../../layouts/Base.astro';
import Catalog from '../../components/Catalog.astro';
import { categoryUrl, getActiveCategories, getResources, type Category } from '../../lib/resources';

export async function getStaticPaths() {
  const resources = await getResources();
  const categories = await getActiveCategories(resources);
  return categories.map((category) => ({
    params: { id: category.id },
    props: {
      category,
      categories,
      resources: resources.filter((r) => r.data.category.id === category.id),
    },
  }));
}

const { category, categories, resources } = Astro.props as {
  category: Category;
  categories: (Category & { count: number })[];
  resources: Awaited<ReturnType<typeof getResources>>;
};
---

<Base title={category.data.title} description={category.data.description} section="browse">
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/resources/">Browse</a> /</nav>
      <h1 id="catalog-title">{category.data.title}</h1>
      <p>{category.data.description}</p>
      <ul class="cat-tabs" aria-label="Categories">
        <li><a href="/resources/">All</a></li>
        {
          categories.map((c) => (
            <li>
              <a href={categoryUrl(c.id)} aria-current={c.id === category.id ? 'page' : undefined}>
                {c.data.title} <span>{c.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </header>
    <Catalog resources={resources} hideCategoryFacet headingId="catalog-title" />
  </div>
</Base>

<style>
  .page-head {
    padding: 28px 0 28px;
  }
  .crumbs {
    font-size: 0.88rem;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .crumbs a {
    color: var(--ink-2);
  }
  .page-head h1 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 6px;
  }
  .page-head p {
    margin: 0;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .cat-tabs {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cat-tabs a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .cat-tabs a:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }
  .cat-tabs a[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .cat-tabs span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.7;
  }
</style>
