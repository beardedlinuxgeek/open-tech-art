---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Icon from '../components/Icon.astro';
import {
  categoryUrl,
  coverImage,
  getActiveCategories,
  getResources,
} from '../lib/resources';
import { SITE } from '../data/site';

const resources = await getResources();
const categories = await getActiveCategories(resources);
const creatorCount = new Set(resources.flatMap((r) => r.data.creators.map((c) => c.name))).size;
const latest = resources.slice(0, 8);

// A representative image per category: its first (featured-first) resource.
const catCovers = categories.map((c) => {
  const first = resources.find((r) => r.data.category.id === c.id);
  return { ...c, cover: first ? coverImage(first) : undefined };
});

// Mosaic for the hero: a few featured covers.
const mosaic = resources
  .filter((r) => r.data.featured)
  .concat(resources.filter((r) => !r.data.featured))
  .slice(0, 4)
  .map((r) => ({ r, img: coverImage(r) }))
  .filter((m) => m.img);
---

<Base section={undefined}>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Open library · Free &amp; openly licensed</p>
        <h1>Technical art you can learn from, use, and build on.</h1>
        <p class="lede">
          Open Tech Art is a curated catalog of free shaders, renderer features, tools and reference scenes.
          Each entry has consistent metadata, honest compatibility notes, and a clear link back to the person
          who made it.
        </p>
        <form class="hero-search" action="/resources/" method="get" role="search">
          <label for="home-q" class="visually-hidden">Search resources</label>
          <Icon name="search" class="hs-icon" />
          <input id="home-q" name="q" type="search" placeholder="Try “toon”, “outline” or “wind”" autocomplete="off" />
          <button class="btn btn-primary" type="submit">Search</button>
        </form>
        <ul class="stats" aria-label="Catalog at a glance">
          <li><strong>{resources.length}</strong> resources</li>
          <li><strong>{creatorCount}</strong> creators credited</li>
          <li><strong>{categories.length}</strong> categories</li>
        </ul>
      </div>
      <div class="mosaic" aria-hidden="true">
        {
          mosaic.map(({ r, img }, i) => (
            <a href={`/resources/${r.id}/`} class={`m m${i}`} tabindex="-1">
              <Image
                src={img!.src}
                alt=""
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 50vw, 320px"
                format="webp"
                quality={76}
                loading={i < 2 ? 'eager' : 'lazy'}
              />
              <span>{r.data.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="block" aria-labelledby="cat-title">
      <div class="block-head">
        <h2 id="cat-title">Browse by category</h2>
        <a href="/resources/" class="more">All resources <Icon name="arrow-right" /></a>
      </div>
      <ul class="cats">
        {
          catCovers.map((c) => (
            <li>
              <a href={categoryUrl(c.id)} class="cat">
                {c.cover && (
                  <Image src={c.cover.src} alt="" widths={[320, 480]} sizes="(max-width: 700px) 50vw, 300px" format="webp" quality={70} />
                )}
                <span class="cat-text">
                  <span class="cat-title">{c.data.title}</span>
                  <span class="cat-count">
                    {c.count} {c.count === 1 ? 'resource' : 'resources'}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="latest-title">
      <div class="block-head">
        <h2 id="latest-title">In the library</h2>
        <a href="/resources/" class="more">Browse &amp; filter <Icon name="arrow-right" /></a>
      </div>
      <div class="grid">
        {latest.map((r) => <ResourceCard resource={r} />)}
      </div>
    </section>

    <section class="block principles" aria-labelledby="principles-title">
      <h2 id="principles-title">How the library works</h2>
      <ol class="pillars">
        <li>
          <h3>Credit first</h3>
          <p>
            We don't re-host resources. Each page puts the original creator and project up front, and every
            download goes to the source.
          </p>
        </li>
        <li>
          <h3>Clearly licensed</h3>
          <p>
            Free of charge isn't enough. Entries need an explicit open license, such as MIT, Apache, CC0 or
            CC BY. If the licensing is ambiguous, the resource stays out.
          </p>
        </li>
        <li>
          <h3>Honest metadata</h3>
          <p>
            Versions, pipelines and VR or mobile support are recorded only when they're known. Anything
            else is marked <em>unknown</em> rather than guessed.
          </p>
        </li>
        <li>
          <h3>Raw → Reference → Showcase</h3>
          <p>
            Our image standard shows what goes in, what the technique does, and what it can achieve. The
            first seed entries use creator screenshots.
          </p>
        </li>
      </ol>
      <div class="contribute-cta">
        <div>
          <h3>Know a resource that belongs here?</h3>
          <p>Entries are plain Markdown files in Git. Suggest one, or open a pull request.</p>
        </div>
        <div class="cta-btns">
          <a class="btn btn-primary" href="/contribute/">How to contribute</a>
          <a class="btn" href={SITE.repo} rel="noopener"><Icon name="github" /> GitHub</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(1200px 400px at 85% -10%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
      var(--bg);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-block: clamp(40px, 7vw, 88px);
  }
  .hero h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.6rem);
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin: 12px 0 18px;
    max-width: 16ch;
  }
  .lede {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0 0 28px;
  }
  .hero-search {
    position: relative;
    display: flex;
    gap: 8px;
    max-width: 560px;
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    height: 52px;
    padding: 0 14px 0 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    color: var(--ink);
    font: inherit;
  }
  .hero-search input:focus {
    outline: 2px solid var(--focus);
    outline-offset: -1px;
  }
  .hero-search :global(.hs-icon) {
    position: absolute;
    left: 14px;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    color: var(--ink-3);
    pointer-events: none;
  }
  .hero-search .btn {
    min-height: 52px;
  }
  .stats {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    color: var(--ink-3);
    font-size: 0.9rem;
  }
  .stats strong {
    color: var(--ink);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
    margin-right: 4px;
  }

  .mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 12px;
  }
  .m {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--img-bg);
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow);
  }
  .m0,
  .m3 {
    transform: translateY(18px);
  }
  .m :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .m span {
    position: absolute;
    left: 8px;
    bottom: 8px;
    max-width: calc(100% - 16px);
    padding: 3px 8px;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.62);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .block {
    margin-top: 64px;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .block h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    margin: 0;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .more:hover {
    color: var(--ink);
  }
  .more :global(svg) {
    width: 16px;
    height: 16px;
  }

  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 14px;
  }
  .cat {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--img-bg);
    text-decoration: none;
    color: #fff;
    isolation: isolate;
  }
  .cat :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.35s ease;
  }
  .cat::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0.1) 65%);
  }
  .cat:hover :global(img) {
    transform: scale(1.04);
  }
  .cat-text {
    position: absolute;
    left: 14px;
    bottom: 12px;
    right: 14px;
    display: flex;
    flex-direction: column;
  }
  .cat-title {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .cat-count {
    font-size: 0.8rem;
    opacity: 0.85;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }

  .principles h2 {
    margin-bottom: 20px;
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    counter-reset: pillar;
  }
  .pillars li {
    background: var(--bg-raised);
    padding: 22px 22px 20px;
    counter-increment: pillar;
  }
  .pillars li::before {
    content: '0' counter(pillar);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .pillars h3 {
    font-size: 1.05rem;
    margin: 8px 0 6px;
  }
  .pillars p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .contribute-cta {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--bg-sunken);
  }
  .contribute-cta h3 {
    margin: 0 0 4px;
    font-size: 1.1rem;
  }
  .contribute-cta p {
    margin: 0;
    color: var(--ink-2);
  }
  .cta-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .m0,
    .m3 {
      transform: none;
    }
    .m span {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
    }
    .hero-search {
      flex-direction: column;
    }
    .hero-search :global(.hs-icon) {
      top: 26px;
    }
  }
</style>
